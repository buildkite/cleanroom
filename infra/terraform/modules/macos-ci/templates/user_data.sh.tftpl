#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/user-data.log) 2>&1

BOOTSTRAP_ENV_PATH='/usr/local/etc/cleanroom-bootstrap-macos.env'
BOOTSTRAP_RUNNER_PATH='/usr/local/bin/cleanroom-bootstrap-macos'

install -d -o root -g wheel -m 0755 /usr/local/etc
install -d -o root -g wheel -m 0755 /usr/local/bin

cat > "$BOOTSTRAP_ENV_PATH" <<EOF
AWS_REGION='${aws_region}'
NAME_PREFIX='${name_prefix}'
BUILDKITE_QUEUE='${buildkite_queue}'
BUILDKITE_TOKEN_PARAM='${buildkite_token_parameter_name}'
AUTOLOGIN_PASSWORD_PARAM='${autologin_password_parameter_name}'
LAUNCHAGENT_MODE='${launchagent_mode}'
SIGNER_MODE='${signer_mode}'
SIGNER_REQUIRE_SIGNING_JOB='${signer_require_signing_job}'
SIGNER_ALLOWED_BRANCHES='${signer_allowed_branches}'
SIGNER_ALLOWED_BRANCH_PREFIXES='${signer_allowed_branch_prefixes}'
SIGNER_ALLOW_TAGS='${signer_allow_tags}'
SIGNER_ALLOW_PULL_REQUESTS='${signer_allow_pull_requests}'
TAILSCALE_AUTH_KEY_PARAM='${tailscale_auth_key_parameter_name}'
TAILSCALE_HOSTNAME_PREFIX='${tailscale_hostname_prefix}'
TAILSCALE_ADVERTISE_TAGS='${tailscale_advertise_tags}'
TAILSCALE_ENABLE_SSH='${tailscale_enable_ssh}'
TAILSCALE_ACCEPT_ROUTES='${tailscale_accept_routes}'
DEPLOY_KEY_PARAM='${git_deploy_key_parameter_name}'
REPO_URL='${repo_url}'
REPO_REF='${repo_ref}'
SETUP_SCRIPT_PATH='${setup_script_path}'
EOF
chmod 0600 "$BOOTSTRAP_ENV_PATH"

cat > "$BOOTSTRAP_RUNNER_PATH" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

BOOTSTRAP_ENV_PATH='/usr/local/etc/cleanroom-bootstrap-macos.env'
exec > >(tee -a /var/log/cleanroom-bootstrap-macos.log) 2>&1

if [ ! -f "$BOOTSTRAP_ENV_PATH" ]; then
  echo "bootstrap env file missing: $BOOTSTRAP_ENV_PATH" >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$BOOTSTRAP_ENV_PATH"
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$${PATH:-}"

retry() {
  local attempts="$1"
  local delay_seconds="$2"
  shift 2

  local n=1
  while true; do
    if "$@"; then
      return 0
    fi

    if [ "$n" -ge "$attempts" ]; then
      return 1
    fi

    sleep "$delay_seconds"
    n=$((n + 1))
  done
}

: "$${AWS_REGION:?AWS_REGION must be set}"
: "$${NAME_PREFIX:?NAME_PREFIX must be set}"
: "$${BUILDKITE_QUEUE:?BUILDKITE_QUEUE must be set}"
: "$${BUILDKITE_TOKEN_PARAM:?BUILDKITE_TOKEN_PARAM must be set}"
: "$${DEPLOY_KEY_PARAM:?DEPLOY_KEY_PARAM must be set}"
: "$${REPO_URL:?REPO_URL must be set}"
: "$${REPO_REF:?REPO_REF must be set}"
: "$${SETUP_SCRIPT_PATH:?SETUP_SCRIPT_PATH must be set}"

if ! command -v aws >/dev/null 2>&1; then
  aws_tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$aws_tmp_dir"' EXIT
  curl -fsSL 'https://awscli.amazonaws.com/AWSCLIV2.pkg' -o "$aws_tmp_dir/AWSCLIV2.pkg"
  installer -pkg "$aws_tmp_dir/AWSCLIV2.pkg" -target /
fi

if ! command -v aws >/dev/null 2>&1; then
  echo "aws CLI is required but not installed" >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  echo "git is required but not installed" >&2
  exit 1
fi

if ! command -v ssh-keyscan >/dev/null 2>&1; then
  echo "ssh-keyscan is required but not installed" >&2
  exit 1
fi

imds_token="$(retry 10 3 curl -fsS -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')"
instance_id="$(retry 10 3 curl -fsS -H "X-aws-ec2-metadata-token: $imds_token" http://169.254.169.254/latest/meta-data/instance-id)"

# Verify the instance role can read SecureString parameters before handoff.
retry 10 3 aws ssm get-parameter \
  --region "$AWS_REGION" \
  --name "$BUILDKITE_TOKEN_PARAM" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text >/dev/null

install -d -o root -g wheel -m 0700 /var/root/.ssh
retry 10 3 aws ssm get-parameter \
  --region "$AWS_REGION" \
  --name "$DEPLOY_KEY_PARAM" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text > /var/root/.ssh/cleanroom_deploy_key
chmod 0600 /var/root/.ssh/cleanroom_deploy_key
touch /var/root/.ssh/known_hosts
ssh-keyscan -t rsa,ecdsa,ed25519 github.com >> /var/root/.ssh/known_hosts
chmod 0644 /var/root/.ssh/known_hosts

repo_root='/opt/cleanroom-bootstrap/repo'
rm -rf "$repo_root"
install -d -o root -g wheel -m 0755 /opt/cleanroom-bootstrap

export GIT_SSH_COMMAND='ssh -i /var/root/.ssh/cleanroom_deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/root/.ssh/known_hosts'

git -c init.defaultBranch=main init "$repo_root" >/dev/null
git -C "$repo_root" remote add origin "$REPO_URL"
retry 5 3 git -C "$repo_root" fetch --depth=1 origin "$REPO_REF"
git -C "$repo_root" checkout -f FETCH_HEAD

unset GIT_SSH_COMMAND
rm -f /var/root/.ssh/cleanroom_deploy_key /var/root/.ssh/known_hosts

setup_script="$repo_root/$SETUP_SCRIPT_PATH"
if [ ! -f "$setup_script" ]; then
  echo "setup script not found: $SETUP_SCRIPT_PATH" >&2
  exit 1
fi

chmod +x "$setup_script"

export AWS_REGION
export BUILDKITE_TOKEN_PARAM
export AUTOLOGIN_PASSWORD_PARAM
export LAUNCHAGENT_MODE
export SIGNER_MODE
export SIGNER_REQUIRE_SIGNING_JOB
export SIGNER_ALLOWED_BRANCHES
export SIGNER_ALLOWED_BRANCH_PREFIXES
export SIGNER_ALLOW_TAGS
export SIGNER_ALLOW_PULL_REQUESTS
export TAILSCALE_AUTH_KEY_PARAM
export TAILSCALE_HOSTNAME_PREFIX
export TAILSCALE_ADVERTISE_TAGS
export TAILSCALE_ENABLE_SSH
export TAILSCALE_ACCEPT_ROUTES
export CLEANROOM_BOOTSTRAP_REGION="$AWS_REGION"
export CLEANROOM_BOOTSTRAP_INSTANCE_ID="$instance_id"
export CLEANROOM_BOOTSTRAP_NAME_PREFIX="$NAME_PREFIX"
export CLEANROOM_BUILDKITE_QUEUE="$BUILDKITE_QUEUE"
export CLEANROOM_BUILDKITE_AUTOLOGIN_PASSWORD_PARAM="$AUTOLOGIN_PASSWORD_PARAM"
export CLEANROOM_BUILDKITE_LAUNCHAGENT_MODE="$LAUNCHAGENT_MODE"
export CLEANROOM_BUILDKITE_SIGNER_MODE="$SIGNER_MODE"
export CLEANROOM_SIGNER_REQUIRE_SIGNING_JOB="$SIGNER_REQUIRE_SIGNING_JOB"
export CLEANROOM_SIGNER_ALLOWED_BRANCHES="$SIGNER_ALLOWED_BRANCHES"
export CLEANROOM_SIGNER_ALLOWED_BRANCH_PREFIXES="$SIGNER_ALLOWED_BRANCH_PREFIXES"
export CLEANROOM_SIGNER_ALLOW_TAGS="$SIGNER_ALLOW_TAGS"
export CLEANROOM_SIGNER_ALLOW_PULL_REQUESTS="$SIGNER_ALLOW_PULL_REQUESTS"
export CLEANROOM_TAILSCALE_AUTH_KEY_PARAMETER_NAME="$TAILSCALE_AUTH_KEY_PARAM"
export CLEANROOM_TAILSCALE_HOSTNAME_PREFIX="$TAILSCALE_HOSTNAME_PREFIX"
export CLEANROOM_TAILSCALE_ADVERTISE_TAGS="$TAILSCALE_ADVERTISE_TAGS"
export CLEANROOM_TAILSCALE_ENABLE_SSH="$TAILSCALE_ENABLE_SSH"
export CLEANROOM_TAILSCALE_ACCEPT_ROUTES="$TAILSCALE_ACCEPT_ROUTES"

"$setup_script"
EOF
chmod 0755 "$BOOTSTRAP_RUNNER_PATH"

"$BOOTSTRAP_RUNNER_PATH"
